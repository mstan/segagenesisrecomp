+/* Self-relative WORD-OFFSET call table behind a computed `jsr (d8,PC,Xn.W)`.
+ *
+ * The Konami/RKA object dispatch idiom is:
+ *     move.w  table(pc,Dn.w),Dn      ; Dn = signed 16-bit offset = table[index]
+ *     jsr     table(pc,Dn.w)         ; call table + offset = the case body
+ *   table:
+ *     dc.w  body0-table, body1-table, ...   ; offsets to case-body subroutines
+ *   body0: ... rts
+ *   body1: ... rts
+ * The case bodies are self-contained subroutines (each ends in rts — they are
+ * CALLED), embedded right after the table. Because the transfer is a JSR, the
+ * targets MUST be first-class function entries (a JSR cannot become an
+ * in-function goto the way the JMP-table forms do); the boundary-splitter then
+ * carves them out of the enclosing function so call_by_address resolves them.
+ *
+ * Strong gate, safe to run unconditionally (no autodiscovery opt-in), because:
+ *  - Every real entry resolves to code WITHIN a tight window of the table base
+ *    (case bodies sit just past the table). Once the walk runs off the table
+ *    end into adjacent code/data, the next "offset" resolves far outside the
+ *    window and the walk stops. The wild garbage offsets that follow a real
+ *    table (RKA's $5F12 table: +8/+28/+48/+76 then +4146/+28672/-20330) are
+ *    rejected by the window in one step.
+ *  - Targets must be even, in-ROM, and decode as a legal MC68000 instruction.
+ * This mirrors jt_enumerate_long's strong per-entry gate for long-pointer
+ * tables, the reason that detector also runs for every game.
+ *
+ * Returns the number of targets pushed as function entries. */
+#define JT_PCRELW_WINDOW 0x800u   /* max |target-base| for a real word offset */
+
+static int
+jt_enumerate_jsr_word_table(const GenesisRom *rom, const GameConfig *cfg,
+                            FunctionList *list, uint32_t base,
+                            const M68KValidatorOptions *vopts) {
+    int pushed = 0;
+    for (int i = 0; i < JT_AUTO_MAX_ENTRIES; i++) {
+        uint32_t entry_addr = base + (uint32_t)i * 2u;
+        if (entry_addr + 1 >= rom->rom_size) break;
+        int16_t  off    = (int16_t)rom_read16(rom, entry_addr);
+        uint32_t target = (uint32_t)((int32_t)base + (int32_t)off);
+
+        /* Window gate: a real self-relative offset lands near the table. */
+        uint32_t dist = (target > base) ? (target - base) : (base - target);
+        if (dist > JT_PCRELW_WINDOW)       break;
+        if (target & 1)                    break;   /* odd = never a code start */
+        if (target >= rom->rom_size)       break;
+
+        /* Validator gate: the body's first instruction must decode legally. */
+        M68KInstr probe;
+        if (!m68k_decode(rom, target, &probe))         break;
+        if (m68k_validate(&probe, vopts) != M68K_LEGAL) break;
+
+        if (cfg && game_config_is_blacklisted(cfg, target)) continue;
+        add_function(list, target);
+        pushed++;
+        s_jt_targets_pushed++;
+    }
+    return pushed;
+}
