# Optional cartridge uploaded-code backend. The generated image/variants remain
# private build inputs; a miss uses the faithful one-instruction fallback.
include_guard(GLOBAL)
option(GENESIS_Z80_RECOMP "Use a guarded statically generated cartridge Z80 image" OFF)
set(GENESIS_Z80_AOT_SOURCE "" CACHE FILEPATH "SmsRecomp --flat-step generated C source")
set(GENESIS_Z80_AOT_ENTRY "" CACHE STRING "Generated step symbol (default: source basename)")

function(genesisrecomp_z80_target target)
    if(NOT GENESIS_Z80_RECOMP)
        return()
    endif()
    get_target_property(_configured ${target} GENESIS_Z80_CONFIGURED)
    if(_configured)
        return()
    endif()
    get_filename_component(_engine "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    get_filename_component(_source "${GENESIS_Z80_AOT_SOURCE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    if(NOT GENESIS_Z80_AOT_SOURCE OR NOT EXISTS "${_source}" OR IS_DIRECTORY "${_source}")
        message(FATAL_ERROR "GENESIS_Z80_RECOMP needs an existing GENESIS_Z80_AOT_SOURCE generated by SmsRecomp --flat-step")
    endif()
    if(NOT EXISTS "${_engine}/external/z80-recomp-core/include/sms_runtime.h")
        message(FATAL_ERROR "GENESIS_Z80_RECOMP needs the pinned external/z80-recomp-core submodule")
    endif()
    set(_entry "${GENESIS_Z80_AOT_ENTRY}")
    if(NOT _entry)
        get_filename_component(_entry "${_source}" NAME_WE)
    endif()
    if(NOT _entry MATCHES "^[A-Za-z_][A-Za-z_0-9]*$")
        message(FATAL_ERROR "GENESIS_Z80_AOT_ENTRY must name one generated C step function")
    endif()
    get_filename_component(_source_dir "${_source}" DIRECTORY)
    target_sources(${target} PRIVATE "${_engine}/runner/z80_recomp.c" "${_source}")
    target_include_directories(${target} PRIVATE "${_engine}/external/z80-recomp-core/include" "${_source_dir}")
    target_compile_definitions(${target} PRIVATE GENESIS_Z80_RECOMP=1 SMS_RUNTIME_NO_CALL_BY_ADDRESS=1 "GENESIS_CONFIGURED_Z80_STEP=${_entry}")
    set_property(TARGET ${target} PROPERTY GENESIS_Z80_CONFIGURED ON)
    message(STATUS "Genesis native Z80: ${target}, step=${_entry}, guarded source=${_source}")
endfunction()
