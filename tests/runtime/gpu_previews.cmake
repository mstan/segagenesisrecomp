set(_pv_root "${CMAKE_CURRENT_LIST_DIR}/../..")
set(_pv_test "${CMAKE_CURRENT_LIST_DIR}")
if(NOT TARGET retcomm_rbengine)
    set(RBE_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    add_subdirectory("${_pv_root}/external/rbengine" "${CMAKE_CURRENT_BINARY_DIR}/gpu-preview-rbengine" EXCLUDE_FROM_ALL)
endif()
add_library(gpu_preview_original OBJECT "${_pv_test}/gpu_reference/local_states.c")
target_include_directories(gpu_preview_original PRIVATE "${_pv_root}/runner")
target_link_libraries(gpu_preview_original PRIVATE retcomm_rbengine)
target_compile_features(gpu_preview_original PRIVATE c_std_11)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_clear=original_genesis_local_states_clear)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_shutdown=original_genesis_local_states_shutdown)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_configure=original_genesis_local_states_configure)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_slot_saved=original_genesis_local_states_slot_saved)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_note_frame=original_genesis_local_states_note_frame)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_open_rewind=original_genesis_local_states_open_rewind)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_open_menu=original_genesis_local_states_open_menu)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_is_open=original_genesis_local_states_is_open)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_selected_slot=original_genesis_local_states_selected_slot)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_move=original_genesis_local_states_move)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_cancel=original_genesis_local_states_cancel)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_accept=original_genesis_local_states_accept)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_save=original_genesis_local_states_save)
target_compile_definitions(gpu_preview_original PRIVATE genesis_local_states_overlay=original_genesis_local_states_overlay)

add_executable(gpu_preview_test "${_pv_test}/gpu_preview_test.c"
    "${_pv_root}/runner/local_states.c" "${_pv_root}/runner/overlay_draw.c"
    $<TARGET_OBJECTS:gpu_preview_original>)
target_include_directories(gpu_preview_test PRIVATE "${_pv_root}/runner")
target_link_libraries(gpu_preview_test PRIVATE retcomm_rbengine)
target_compile_features(gpu_preview_test PRIVATE c_std_11)
foreach(_target IN ITEMS gpu_preview_original gpu_preview_test)
    if(MSVC)
        target_compile_options(${_target} PRIVATE /W4 /WX)
        target_compile_definitions(${_target} PRIVATE _CRT_SECURE_NO_WARNINGS)
    else()
        target_compile_options(${_target} PRIVATE -Wall -Wextra -Werror)
    endif()
endforeach()
add_test(NAME gpu_preview COMMAND gpu_preview_test "${CMAKE_CURRENT_BINARY_DIR}/gpu-preview-evidence")
