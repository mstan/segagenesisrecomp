set(_psg_wrapper "${CMAKE_CURRENT_LIST_DIR}/../../runner/audio/sn76489.c")
add_library(psg_scalar_test_model OBJECT "${CMAKE_CURRENT_LIST_DIR}/psg_scalar_reference.c")
target_include_directories(psg_scalar_test_model PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../../runner/audio" "${CMAKE_CURRENT_LIST_DIR}/../../runner" "${CMAKE_CURRENT_LIST_DIR}/../../runner/include")
target_compile_definitions(psg_scalar_test_model PRIVATE GENESIS_PSG_SILENT_SPANS=0)
foreach(_psg_api init advance write render samples_available sample_rate reset_leftover save_state load_state cosim_hash rb_save rb_load)
    target_compile_definitions(psg_scalar_test_model PRIVATE psg_${_psg_api}=ref_psg_${_psg_api})
endforeach()
add_executable(psg_span_test "${CMAKE_CURRENT_LIST_DIR}/psg_span_test.c" "${_psg_wrapper}" $<TARGET_OBJECTS:psg_scalar_test_model>)
target_include_directories(psg_span_test PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../../runner" "${CMAKE_CURRENT_LIST_DIR}/../../runner/include")
target_compile_definitions(psg_span_test PRIVATE GENESIS_PSG_SILENT_SPANS=1 GENESIS_PSG_EVENT_SPANS=1)
add_test(NAME psg_span COMMAND psg_span_test)

add_executable(psg_span_fallback_test "${CMAKE_CURRENT_LIST_DIR}/psg_span_test.c" "${_psg_wrapper}" $<TARGET_OBJECTS:psg_scalar_test_model>)
target_include_directories(psg_span_fallback_test PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../../runner" "${CMAKE_CURRENT_LIST_DIR}/../../runner/include")
target_compile_definitions(psg_span_fallback_test PRIVATE GENESIS_PSG_SILENT_SPANS=1 GENESIS_PSG_EVENT_SPANS=0)
add_test(NAME psg_span_fallback COMMAND psg_span_fallback_test)
