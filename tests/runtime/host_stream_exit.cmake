set(args --exit-stream "${OUTPUT}")
if(QUIT_FIRST)
    list(APPEND args quit-first)
endif()
execute_process(COMMAND "${EXE}" ${args} RESULT_VARIABLE result TIMEOUT 30)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Exit-drain child failed: ${result}")
endif()
file(SIZE "${OUTPUT}" size)
file(SHA256 "${OUTPUT}" sha)
if(NOT size EQUAL 12345 OR NOT sha STREQUAL "c4f33cbc3a69228d59ea948e3cb773cd49d5ca00e3b60cc7203ba38de6c431a0")
    message(FATAL_ERROR "Exit-drain bytes changed: ${size} ${sha}")
endif()
