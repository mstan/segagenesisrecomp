# Shared final-pixel ownership and actual machine adapter versus frozen426.
set(_pixel_root "${CMAKE_CURRENT_LIST_DIR}/../..")
set(_pixel_source "${CMAKE_CURRENT_LIST_DIR}")
add_library(pixel_original_machine OBJECT "${_pixel_source}/pixel_reference/genesis_machine.c")
target_include_directories(pixel_original_machine PRIVATE "${_pixel_root}/runner/video" "${_pixel_root}/runner" "${_pixel_root}/runner/external/superzazu")
target_compile_features(pixel_original_machine PRIVATE c_std_11)
foreach(_name IN ITEMS g_machine g_sndwatch snd_trace_68k_write snd_trace_z80 snd_trace_busreq snd_trace_dump z80_ram_dump machine_z80_pc machine_init machine_save_state machine_load_state machine_rb_save machine_rb_load machine_set_pad machine_set_pad_type machine_z80_stamp machine_run_frame_ex machine_run_frame)
    target_compile_definitions(pixel_original_machine PRIVATE ${_name}=original_${_name})
endforeach()
foreach(_mode IN ITEMS pipeline fallback)
    add_executable(pixels_${_mode} "${_pixel_source}/pixel_pipeline_test.c" "${_pixel_source}/pixel_original.c")
    add_executable(indexed_machine_${_mode} "${_pixel_source}/indexed_machine_test.c"
        "${_pixel_root}/runner/video/genesis_machine.c" "${_pixel_root}/runner/video/genesis_vdp.c"
        "${_pixel_root}/runner/external/superzazu/z80.c" $<TARGET_OBJECTS:pixel_original_machine>)
    target_compile_definitions(indexed_machine_${_mode} PRIVATE GENESIS_BATCHED_PLANES=1)
    foreach(_target IN ITEMS pixels_${_mode} indexed_machine_${_mode})
        target_include_directories(${_target} PRIVATE "${_pixel_root}/runner/video" "${_pixel_root}/runner" "${_pixel_root}/runner/external/superzazu")
        target_compile_features(${_target} PRIVATE c_std_11)
        if(_mode STREQUAL "fallback")
            target_compile_definitions(${_target} PRIVATE GENESIS_FINAL_PIXEL_PIPELINE=0)
        endif()
        if(MSVC)
            target_compile_options(${_target} PRIVATE /W4 /WX)
        else()
            target_compile_options(${_target} PRIVATE -Wall -Wextra -Werror)
        endif()
        add_test(NAME ${_target} COMMAND ${_target})
    endforeach()
endforeach()
