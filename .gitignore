build/
*.bin

# External disasm clones (sibling repos under per-game dirs).
# Sonic 1 keeps its disasm outside the tree; Sonic 2 / future ports
# clone alongside game.cfg for the regen pipeline. Track *.cfg and
# tooling output, not the disasm source tree itself.
**/s1disasm/
**/s2disasm/
**/skdisasm/

# Per-run / generated artifacts.
**/__pycache__/
tests/last_run/
**/*.unresolved_jumptables.log

# Internal licensing/teardown working note — never commit
LICENSING.md

# accuracy worktree: local synth_replay builds + capture runs
tools/synth_replay/_run_*/
tools/synth_replay/build_acc*/
tools/synth_replay/build/

# accuracy worktree: local-only BlastEm GPLv3 oracle (dev-only, never shipped,
# never linked into our binaries). Source tree + build artifacts stay local.
tools/blastem/

# accuracy worktree: cycle comparator capture artifacts (big rings / ROM) stay
# local; only the tool + its text report are tracked.
tools/cycle_compare/*
!tools/cycle_compare/cycle_delta_compare.py
!tools/cycle_compare/comparator_report.txt
