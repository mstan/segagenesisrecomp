<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <application android:label="${gameTitle}" android:allowBackup="false" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" android:extractNativeLibs="true">
        <activity android:name="org.genesisrecompiled.SetupActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name="org.genesisrecompiled.GameActivity" android:exported="false" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode" />
    </application>
</manifest>
